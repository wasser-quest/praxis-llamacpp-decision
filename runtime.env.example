# Copy to runtime.env, chmod 600, then edit privately. Never commit real values.
NB_SETUP_KEY=
# NB_MANAGEMENT_URL=https://your-netbird-management.example

# 16 GB VRAM recipe from the GenerelSchwerz guide (moe-cache fork):
# https://github.com/GenerelSchwerz/llama.cpp/wiki/16GB-VRAM-Setup
# Qwen3.6-35B-A3B Q4_K_M (~20.4 GB, one GGUF) with CUDA MoE expert cache.
# Downloads the pinned GGUF (~20.4 GB) and the Nomic embedding weights (~274 MB);
# verifies pinned SHA256s and reuses cached files.
LLAMA_DOWNLOAD_MODELS=1
LLAMA_MODEL_DIR=/workspace/llama.cpp/models/qwen3.6-35b-a3b
LLAMA_DOWNLOAD_TIMEOUT_SECONDS=21600
# Recommended start: 96 expert-cache slots per cached tensor on 16 GB VRAM
# (guide measured 132 -> 14,369 MiB peak on RTX 5070 Ti; 96 leaves more reserve).
LLAMA_MOE_CACHE_SIZE=96
# Guide geometry: 64K context, batch/ubatch 8192, F16 KV offloaded, load-mode none.
LLAMA_CONTEXT_SIZE=65536
LLAMA_BATCH_SIZE=8192
LLAMA_UBATCH_SIZE=8192
# One worker per available physical core, not per SMT/logical CPU.
# Respects process affinity/cpuset and visible CPU quotas; unset also means auto.
LLAMA_THREADS=auto
# Optional manual override (bypasses auto detection): LLAMA_THREADS=12
# Per-instance tuning may override these values in /workspace/llama.cpp/runtime-settings.json
# (e.g. {"LLAMA_MOE_CACHE_SIZE": 132}); restart only the chat service after measuring VRAM.
LLAMA_EMBEDDING_ENABLED=1
LLAMA_EMBEDDING_MODEL_DIR=/workspace/llama.cpp/models/nomic-embed-text
# Host pinning stays enabled; 0 removes the presence-based flag in the child.
GGML_CUDA_REGISTER_HOST=1
# Do not carry OLLAMA_* or LLAMA_ARG_* settings over from the other stack:
# this recipe derives every llama.cpp argument from the settings above.