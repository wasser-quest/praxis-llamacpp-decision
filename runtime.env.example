# Copy to runtime.env, chmod 600, then edit privately. Never commit real values.
NB_SETUP_KEY=
# NB_MANAGEMENT_URL=https://your-netbird-management.example

# ===== Model selection =====================================================
# Every chat model is a pinned "variant" in scripts/llama-models.json. Choose
# one by name; unset means the manifest default.
#
#   qwen3.8-flash-next   (DEFAULT) unsloth/Qwen3.8-Flash-Next-GGUF
#                         UD-IQ3_XXS, 3 shards, 82 GB + shared Q8 MTP draft
#                         head (2.8 GB). 177B MoE; 82 GB is WEIGHT FILE SIZE,
#                         not a VRAM requirement. GS CPU experts use host RAM;
#                         96 GiB+ is preferable to a 62 GiB host for this recipe.
#                         Default: 262144 ctx / 512 batch / 56 cache. GPU KV,
#                         cache and parallel Decision model require acceptance.
#
#   qwen3.6-35b-a3b      ggml-org/Qwen3.6-35B-A3B-GGUF Q4_K_M, one 20.4 GB file.
#                         Current default: 131072 ctx / 8192 batch / cache 96,
#                         F16 KV, load-mode none; >=32 GB host RAM. The upstream
#                         16 GB reference used different geometry, not a fit guarantee.
#
#   qwen3.8-27b           unsloth/Qwen3.8-27B-GGUF UD-Q4_K_M (16.5 GB) + Q4_0
#                         MTP draft head (1.4 GB). Dense 27B; no MoE experts so
#                         the cache stays 0. Default: 32768 ctx / 1024 batch.
#                         A 24 GB card is a candidate only: test KV/cache/runtime
#                         headroom including the enabled Decision service.
#
# How to switch: set LLAMA_MODEL (and optionally LLAMA_MODEL_DIR) BEFORE the
# first start; the container downloads and SHA256-verifies that variant's
# pinned files on first run.
#   Example: LLAMA_MODEL=qwen3.6-35b-a3b
#   Example: LLAMA_MODEL=qwen3.8-27b
LLAMA_MODEL=qwen3.8-flash-next
# Optional override for the model directory (default
# /workspace/llama.cpp/models/<variant>; the MTP draft head, if any, lands
# in <dir>/MTP automatically):
# LLAMA_MODEL_DIR=/workspace/llama.cpp/models/qwen3.8-flash-next
LLAMA_DOWNLOAD_MODELS=1
LLAMA_DOWNLOAD_TIMEOUT_SECONDS=21600
# One worker per available physical core, not per SMT/logical CPU.
# Respects process affinity/cpuset and visible CPU quotas; unset also means auto.
LLAMA_THREADS=auto
# Optional manual override (bypasses auto detection): LLAMA_THREADS=12
# Per-variant geometry is overridable between the bounds of the launcher, e.g.
#   LLAMA_CONTEXT_SIZE=8192  (Flash-Next default 262144; explicit reduction)
#   LLAMA_MOE_CACHE_SIZE=80  (variant default 56)
#   LLAMA_BATCH_SIZE=512 / LLAMA_UBATCH_SIZE=512
# and persistently in /workspace/llama.cpp/runtime-settings.json (bounded
# allowlist; restart only the chat service after measuring VRAM).
LLAMA_EMBEDDING_ENABLED=1
LLAMA_EMBEDDING_MODEL_DIR=/workspace/llama.cpp/models/nomic-embed-text
# Host pinning stays enabled; 0 removes the presence-based flag in the child.
GGML_CUDA_REGISTER_HOST=1
# Do not carry OLLAMA_* or LLAMA_ARG_* settings over from the other stack:
# this recipe derives every llama.cpp argument from the variant + settings above.
# --- Jev-Decision-Server (parallel-decision, :11440) ---
# LLAMA_DECISION_ENABLED=1     # 0 = Server aus
# LLAMA_DECISION_MODEL=qwen3-1.7b   # aus llama-models.json:decisions
# LLAMA_DECISION_PORT=11440
# LLAMA_DECISION_NGL=999       # 999 = GPU; 0 = CPU-only (uses host RAM/CPU, not free)
# LLAMA_DECISION_CONTEXT=8192

# --- Chat-Rezept (nur relevant fuer qwen3.8-flash-next) ---
# gs      (Default): GenerelSchwerz LRU-Expert-Cache (--moe-expert-cache-size)
# codacus        : ORIGINAL-Flash-Next-Setup aus praxis-llamap-gpu — Routing-
#                  Profil (--moe-cache-profile/-slots) + llama-moe-trace.
#                  Vor erstem Start: python3 /opt/praxis/bin/profile_llama.py
#                  (2 GPU-Traces ~1h, einmalig) — oder bestehendes Profil per
#                  --adopt-existing uebernehmen.
# LLAMA_CHAT_RECIPE=codacus
# LLAMA_MOE_CACHE_SLOTS=56
# LLAMA_MOE_CACHE_PROFILE=/workspace/llama.cpp/profiles/qwen3.8-flash-next-merged.csv
# LLAMA_TRACE_TIMEOUT_SECONDS=3600  # each trace: 60..7200 seconds, no automatic retries
# LLAMA_MOE_CACHE_ENABLED=0    # codacus-Expert-Cache AUS: kein Profil noetig,
                              # reine Baseline-Placement (mmap + CPU-Experts).
# Existing mismatched profile receipts are preserved; inspect before explicit adoption.
# LLAMA_GENERATE_PROFILE=1     # fehlendes Profil beim Start automatisch
                              # capturen (2 GPU-Traces ~1h, einmalig pro Modell)
